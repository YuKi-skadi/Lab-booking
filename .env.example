# 存储后端: sqlite | mysql | postgres | json
STORAGE_BACKEND=sqlite

# 运行角色: all（本地开发）| split（Docker 单容器双端口）| public/admin（单角色运行）
APP_ROLE=all

# 只有确实需要跨域访问时才填写，多个来源用逗号分隔；同源部署留空
CORS_ORIGINS=

# SQLite 配置 (默认，无需额外配置)
SQLITE_URL=sqlite:///./data/bookings.db

# MySQL 配置
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=lab
# MYSQL_PASSWORD=replace_with_strong_password
# MYSQL_DATABASE=lab_booking

# PostgreSQL 配置
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=lab
# POSTGRES_PASSWORD=replace_with_strong_password
# POSTGRES_DATABASE=lab_booking

# JSON 文件存储路径
JSON_DATA_DIR=./data

# 可用教室列表 (逗号分隔)
CLASSROOMS=101实验室,102实验室,201机房,202机房,301多媒体教室,302多媒体教室,401研讨室,402研讨室

# 允许的借用时间段 (HH:MM 格式，逗号分隔)
TIME_SLOTS=08:00-09:35,09:50-11:25,11:40-13:15,13:30-15:05,15:20-16:55,17:10-18:45

# 服务端口（本地运行或 Docker 预约端内部端口）
PORT=8000

# Docker 单容器双端口模式下的管理端内部端口
ADMIN_PORT=8001

# 管理端绑定地址：默认仅本机可访问；NAS 局域网管理时可改为 0.0.0.0，
# 同时必须在 NAS 防火墙中限制 8001 仅允许局域网来源
ADMIN_BIND_IP=127.0.0.1

# Docker 管理端宿主机端口
ADMIN_PORT=8001

# 管理员密码（Docker 公网部署时必须改成高强度随机密码）
ADMIN_PASSWORD=

# 可选：本地部署专用的初始数据覆盖（不会改变代码中的通用默认值）
# 留空时使用 settings_manager.py 中的通用示例数据
LAB_BOOKING_DEFAULT_CLASSROOMS=101实验室,102实验室,201机房,202机房,301多媒体教室,302多媒体教室,401研讨室,402研讨室
LAB_BOOKING_DEFAULT_MAJORS=计算机科学与技术,软件工程,电子信息工程,通信工程,机械工程,自动化,电气工程,材料科学与工程,化学工程,生物工程,数学与应用数学,物理学,应用化学,工商管理,会计学,金融学
LAB_BOOKING_DEFAULT_TIME_SLOTS_JSON='[{"slot":"08:00-09:35","remark":"第一课时"},{"slot":"09:50-11:25","remark":"第二课时"},{"slot":"11:40-13:15","remark":"第三课时"},{"slot":"13:30-15:05","remark":"第四课时"},{"slot":"15:20-16:55","remark":"第五课时"},{"slot":"17:10-18:45","remark":"第六课时"}]'
