# 存储后端: sqlite | mysql | postgres | json
STORAGE_BACKEND=sqlite

# SQLite 配置 (默认，无需额外配置)
SQLITE_URL=sqlite:///./data/bookings.db

# MySQL 配置
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=lab
# MYSQL_PASSWORD=lab123
# MYSQL_DATABASE=lab_booking

# PostgreSQL 配置
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=lab
# POSTGRES_PASSWORD=lab123
# POSTGRES_DATABASE=lab_booking

# JSON 文件存储路径
JSON_DATA_DIR=./data

# 可用教室列表 (逗号分隔)
CLASSROOMS=101实验室,102实验室,201机房,202机房,301多媒体教室,302多媒体教室,401研讨室,402研讨室

# 允许的借用时间段 (HH:MM 格式，逗号分隔)
TIME_SLOTS=08:00-09:35,09:50-11:25,11:40-13:15,13:30-15:05,15:20-16:55,17:10-18:45

# 服务端口
PORT=8000

# 管理员密码 (用于管理面板)
ADMIN_PASSWORD=admin123
